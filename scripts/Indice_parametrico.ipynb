   "source": [
    "# Estadísticas necesarias para reproducir el cálculo en JavaScript, ahora en unidades\n",
    "# reales (°C, mm) en vez de la anomalía cruda — más intuitivo para el simulador.\n",
    "#\n",
    "# 4 de las 7 variables del índice son ANOMALÍAS calculadas en Preprocesamiento_2.ipynb con\n",
    "# historical_anomaly(): anomalia = (valor_absoluto - media_historica_municipio) / std_historica_municipio.\n",
    "# La columna absoluta de origen SÍ sigue estando en el panel (historical_anomaly no la elimina),\n",
    "# así que podemos mostrarle al usuario el valor real (ej. \"19.4°C\") y reconstruir la anomalía\n",
    "# nosotros mismos en el front-end con la media/desviación histórica del municipio elegido.\n",
    "# Las otras 3 (PDSI y humedad de suelo) ya son absolutas, no requieren esta conversión.\n",
    "\n",
    "MAPEO_COLUMNA_BASE = {\n",
    "    \"temp_media_anual_anomalia\": (\"temp_media_anual\", \"°C\"),\n",
    "    \"precip_anual_mm_anomalia\": (\"precip_anual_mm\", \"mm\"),\n",
    "    \"pr_anual_mm_anomalia\": (\"pr_anual_mm\", \"mm\"),\n",
    "    \"balance_hidrico_anual_anomalia\": (\"balance_hidrico_anual\", \"mm\"),\n",
    "}\n",
    "\n",
    "VARIABLES_SEQUIA = [\"temp_media_anual_anomalia\", \"pdsi_media_anual\", \"pdsi_min_anual\", \"soil_moisture_media\"]\n",
    "SIGNOS_SEQUIA    = [1, -1, -1, -1]   # coincide con el signo aplicado al construir IC_sequia\n",
    "\n",
    "VARIABLES_EXCESO = [\"precip_anual_mm_anomalia\", \"pr_anual_mm_anomalia\", \"balance_hidrico_anual_anomalia\"]\n",
    "SIGNOS_EXCESO    = [1, 1, 1]\n",
    "\n",
    "def describir_variable(df, nombre_col):\n",
    "    es_anomalia = nombre_col in MAPEO_COLUMNA_BASE\n",
    "    col_base, unidad = MAPEO_COLUMNA_BASE.get(nombre_col, (nombre_col, \"\"))\n",
    "\n",
    "    # estadísticas departamentales de la columna anomalía/índice tal cual la usa zscore() en IC_sequia/IC_exceso\n",
    "    global_zscore = {\"mean\": float(df[nombre_col].mean()), \"std\": float(df[nombre_col].std())}\n",
    "\n",
    "    # estadísticas departamentales de la columna ABSOLUTA (para límites del slider y como\n",
    "    # valor por defecto cuando no se elige municipio)\n",
    "    abs_rango = {\n",
    "        \"mean\": float(df[col_base].mean()), \"std\": float(df[col_base].std()),\n",
    "        \"min\": float(df[col_base].min()), \"max\": float(df[col_base].max()),\n",
    "    }\n",
    "    return {\n",
    "        \"columna_base\": col_base, \"es_anomalia\": es_anomalia, \"unidad\": unidad,\n",
    "        \"global_zscore\": global_zscore, \"abs_rango\": abs_rango,\n",
    "    }\n",
    "\n",
    "info_sequia = {v: describir_variable(panel_v2, v) for v in VARIABLES_SEQUIA}\n",
    "info_exceso = {v: describir_variable(panel_v2, v) for v in VARIABLES_EXCESO}\n",
    "\n",
    "for grupo_nombre, grupo in [(\"sequía\", info_sequia), (\"exceso\", info_exceso)]:\n",
    "    print(f\"Variables de {grupo_nombre}:\")\n",
    "    for v, info in grupo.items():\n",
    "        print(f\"  {v} -> {info['columna_base']} ({info['unidad'] or 'índice'}), \"\n",
    "              f\"rango absoluto ({info['abs_rango']['min']:.1f}, {info['abs_rango']['max']:.1f})\")\n"
   ]
