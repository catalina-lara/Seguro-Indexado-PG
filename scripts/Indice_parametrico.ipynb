      "soil_moisture_media                0.063962  \n",
      "pr_anual_mm_anomalia               0.045155  \n",
      "soil_media_anual                   0.039245  \n",
      "ndvi_min_anual                     0.032585  \n"
     ]
    }
   ],
   "source": [
    "# Variables climaticas dinamicas\n",
    "VARIABLES_IC_V1 = [\n",
    "    \"temp_media_anual_anomalia\", \"pr_anual_mm_anomalia\", \"precip_anual_mm_anomalia\",\n",
    "    \"soil_media_anual\", \"pdsi_min_anual\", \"ndvi_min_anual\",\n",
    "    \"soil_moisture_media\", \"pdsi_media_anual\",\n",
    "]\n",
    "VARIABLES_IC_V1 = [v for v in VARIABLES_IC_V1 if v in panel.columns]\n",
    "panel_v1 = panel.dropna(subset=VARIABLES_IC_V1 + [\"rendimiento_anomalia_z\"]).copy()\n",
    "print(f\"Filas utilizables para el índice v1: {panel_v1.shape[0]}\")\n",
    "\n",
    "pesos_v1 = {}\n",
    "for var in VARIABLES_IC_V1:\n",
    "    z = (panel_v1[var] - panel_v1[var].mean()) / panel_v1[var].std()\n",
    "    corr = z.corr(panel_v1[\"perdida\"])\n",
    "    signo = 1 if corr >= 0 else -1\n",
    "    panel_v1[f\"{var}_z_signed\"] = signo * z\n",
    "    pesos_v1[var] = {\"correlacion_con_perdida\": corr, \"signo_aplicado\": signo}\n",
    "\n",
    "pesos_v1_df = pd.DataFrame(pesos_v1).T\n",
    "pesos_v1_df[\"peso_abs\"] = pesos_v1_df[\"correlacion_con_perdida\"].abs()\n",
    "pesos_v1_df[\"peso_normalizado\"] = pesos_v1_df[\"peso_abs\"] / pesos_v1_df[\"peso_abs\"].sum()\n",
    "print(pesos_v1_df.sort_values(\"peso_normalizado\", ascending=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "f9c3102c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Correlación IC_v1 <-> proxy de pérdida: 0.245\n",
      "(Referencia: Grupo 5 exigía >= 0.60 para su índice; con R² tan bajo en el modelo base, se espera un valor mucho menor)\n"
     ]
    }
   ],
   "source": [
    "panel_v1[\"IC_v1\"] = sum(\n",
    "    pesos_v1_df.loc[var, \"peso_normalizado\"] * panel_v1[f\"{var}_z_signed\"] for var in VARIABLES_IC_V1\n",
    ")\n",
    "\n",
    "corr_ic_v1 = panel_v1[\"IC_v1\"].corr(panel_v1[\"perdida\"])\n",
    "print(f\"Correlación IC_v1 <-> proxy de pérdida: {corr_ic_v1:.3f}\")\n",
    "print(\"(Referencia: Grupo 5 exigía >= 0.60 para su índice; con R² tan bajo en el modelo \"\n",
    "      \"base, se espera un valor mucho menor)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "66bd9af0",
   "metadata": {},
   "source": [
    "## Calibracion (N3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1e3bb3fc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   percentil  frecuencia_activacion    recall  precision\n",
      "0         70               0.300156  0.320312   0.212435\n",
      "1         75               0.250389  0.281250   0.223602\n",
      "2         80               0.200622  0.218750   0.217054\n",
      "3         85               0.150855  0.148438   0.195876\n",
      "4         90               0.101089  0.109375   0.215385\n",
      "\n",
      "Umbral elegido: percentil 85 (IC >= 0.791)\n",
      "Frecuencia de activación: 15.1% (N3, 10-20%: CUMPLE)\n"
     ]
    }
   ],
   "source": [
    "resultados_v1 = []\n",
    "for percentil in [70, 75, 80, 85, 90]:\n",
    "    umbral = np.percentile(panel_v1[\"IC_v1\"], percentil)\n",
    "    activado = panel_v1[\"IC_v1\"] >= umbral\n",
    "    freq = activado.mean()\n",
    "    tp = (activado & panel_v1[\"anio_perdida\"]).sum()\n",
    "    fp = (activado & ~panel_v1[\"anio_perdida\"]).sum()\n",
    "    fn = (~activado & panel_v1[\"anio_perdida\"]).sum()\n",
    "    recall = tp / (tp + fn) if (tp + fn) > 0 else np.nan\n",
    "    precision = tp / (tp + fp) if (tp + fp) > 0 else np.nan\n",
    "    resultados_v1.append({\"percentil\": percentil, \"umbral_IC\": umbral,\n",
    "                           \"frecuencia_activacion\": freq, \"recall\": recall, \"precision\": precision})\n",
    "\n",
    "resumen_v1 = pd.DataFrame(resultados_v1)\n",
    "print(resumen_v1[[\"percentil\", \"frecuencia_activacion\", \"recall\", \"precision\"]])\n",
    "\n",
    "resumen_v1[\"dist_a_15pct\"] = (resumen_v1[\"frecuencia_activacion\"] - 0.15).abs()\n",
    "fila_v1 = resumen_v1.loc[resumen_v1[\"dist_a_15pct\"].idxmin()]\n",
    "UMBRAL_V1_FINAL = fila_v1[\"umbral_IC\"]\n",
    "panel_v1[\"activado\"] = panel_v1[\"IC_v1\"] >= UMBRAL_V1_FINAL\n",
    "\n",
    "print(f\"\\nUmbral elegido: percentil {int(fila_v1['percentil'])} (IC >= {UMBRAL_V1_FINAL:.3f})\")\n",
    "print(f\"Frecuencia de activación: {fila_v1['frecuencia_activacion']:.1%} \"\n",
    "      f\"(N3, 10-20%: {'CUMPLE' if 0.10 <= fila_v1['frecuencia_activacion'] <= 0.20 else 'NO CUMPLE'})\")"
   ]
  },
