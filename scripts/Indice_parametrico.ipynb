   ],
   "source": [
    "cols_diag = [\"temp_media_anual_anomalia\", \"pr_anual_mm_anomalia\", \"precip_anual_mm_anomalia\",\n",
    "             \"pdsi_media_anual\", \"pdsi_min_anual\", \"soil_moisture_media\",\n",
    "             \"balance_hidrico_anual_anomalia\"]\n",
    "cols_diag = [c for c in cols_diag if c in panel.columns]\n",
    "\n",
    "sub2010 = panel[(panel[\"anio\"] == 2010) & (panel[\"anio_perdida\"])]\n",
    "comparacion = pd.DataFrame({\n",
