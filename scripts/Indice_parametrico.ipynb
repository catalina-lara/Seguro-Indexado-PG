   ],
   "source": [
    "for anio in [2010, 2015]:\n",
    "    sub = panel_v1[panel_v1[\"anio\"] == anio]\n",
    "    if len(sub) == 0:\n",
    "        print(f\"[AVISO] Año {anio} no disponible.\"); continue\n",
