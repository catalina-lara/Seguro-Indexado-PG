   "source": [
    "# V1 - Indice compuesto unico"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dca857a2",
   "metadata": {},
   "source": [
    "## Variables y pesos"
   ]
  },
  {
   "cell_type": "code",
