    "# Curva de payout\n",
    "Se construye una curva de payout continua que traduce la magnitud del índice en un monto de indemnización proporcional a la severidad."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "c51d5848",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filas activadas para calibrar la curva: 116\n",
      "              anio   severidad     perdida\n",
      "count   116.000000  116.000000  116.000000\n",
      "mean   2014.974138    0.406162    0.030666\n",
      "std       5.695858    0.364071    0.858881\n",
      "min    2008.000000    0.001062   -2.436396\n",
      "25%    2011.000000    0.094005   -0.547944\n",
      "50%    2011.000000    0.319129    0.002747\n",
      "75%    2020.000000    0.568387    0.698164\n",
      "max    2024.000000    1.348101    1.734416\n"
     ]
    }
   ],
   "source": [
    "# Severidad: cuánto superó el índice a su propio umbral (0 si no activó)\n",
    "panel_v2[\"severidad_sequia\"] = (panel_v2[\"IC_sequia\"] - U_SEQ_FINAL).clip(lower=0)\n",
    "panel_v2[\"severidad_exceso\"] = (panel_v2[\"IC_exceso\"] - U_EXC_FINAL).clip(lower=0)\n",
    "panel_v2[\"severidad\"] = panel_v2[[\"severidad_sequia\", \"severidad_exceso\"]].max(axis=1)\n",
    "\n",
    "activados = panel_v2[panel_v2[\"activado\"]]\n",
    "print(f\"Filas activadas para calibrar la curva: {len(activados)}\")\n",
    "print(activados[[\"municipio\", \"anio\", \"severidad\", \"perdida\"]].describe())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "2b2c41af",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PAYOUT_MAX (percentil 99 de pérdidas en zona de disparo): 1.582\n"
     ]
    }
   ],
   "source": [
    "# PAYOUT_MAX calibrado como percentil 99 de las pérdidas históricas en la zona de disparo\n",
    "PAYOUT_MAX = activados[\"perdida\"].quantile(0.99)\n",
    "print(f\"PAYOUT_MAX (percentil 99 de pérdidas en zona de disparo): {PAYOUT_MAX:.3f}\")\n",
    "\n",
    "X = activados[[\"severidad\"]].values\n",
    "y = activados[\"perdida\"].values\n",
    "\n",
    "# Plan A: regresión lineal simple (severidad -> pérdida)\n",
    "modelo_lineal = LinearRegression().fit(X, y)\n",
    "\n",
    "# Plan B: regresión polinómica grado 2\n",
    "coefs_poly = np.polyfit(activados[\"severidad\"], activados[\"perdida\"], deg=2)\n",
    "\n",
    "def payout_binario(row):\n",
    "    return PAYOUT_MAX if row[\"activado\"] else 0.0\n",
    "\n",
    "def payout_lineal(row):\n",
    "    if not row[\"activado\"]:\n",
    "        return 0.0\n",
    "    pago = modelo_lineal.predict([[row[\"severidad\"]]])[0]\n",
    "    return float(np.clip(pago, 0, PAYOUT_MAX))\n",
    "\n",
    "def payout_poly(row):\n",
    "    if not row[\"activado\"]:\n",
    "        return 0.0\n",
    "    pago = np.polyval(coefs_poly, row[\"severidad\"])\n",
    "    return float(np.clip(pago, 0, PAYOUT_MAX))\n",
    "\n",
    "panel_v2[\"pago_binario\"] = panel_v2.apply(payout_binario, axis=1)\n",
    "panel_v2[\"pago_lineal\"] = panel_v2.apply(payout_lineal, axis=1)\n",
    "panel_v2[\"pago_poly\"] = panel_v2.apply(payout_poly, axis=1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "e85e76de",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "                    esquema  hedge_effectiveness  correlacion_pago_perdida\n",
      "0  Binario (v1/v2 original)            -0.409472                 -0.004367\n",
      "1          Lineal calibrado             0.007837                  0.088985\n",
      "2        Polinómico grado 2             0.007838                  0.089074\n",
      "\n",
      "Mejor esquema: Polinómico grado 2\n"
     ]
    }
   ],
   "source": [
    "def hedge_effectiveness(perdida, pago):\n",
    "    var_perdida = np.var(perdida)\n",
    "    var_residual = np.var(perdida - pago)\n",
    "    return 1 - (var_residual / var_perdida) if var_perdida > 0 else np.nan\n",
    "\n",
    "resultados_payout = []\n",
    "for nombre, col in [(\"Binario (v1/v2 original)\", \"pago_binario\"),\n",
    "                     (\"Lineal calibrado\", \"pago_lineal\"),\n",
    "                     (\"Polinómico grado 2\", \"pago_poly\")]:\n",
    "    he = hedge_effectiveness(panel_v2[\"perdida\"], panel_v2[col])\n",
    "    corr = panel_v2[\"perdida\"].corr(panel_v2[col])\n",
    "    resultados_payout.append({\"esquema\": nombre, \"hedge_effectiveness\": he, \"correlacion_pago_perdida\": corr})\n",
    "\n",
    "resumen_payout = pd.DataFrame(resultados_payout)\n",
    "print(resumen_payout)\n",
    "\n",
    "mejor_esquema = resumen_payout.loc[resumen_payout[\"hedge_effectiveness\"].idxmax(), \"esquema\"]\n",
    "print(f\"\\nMejor esquema: {mejor_esquema}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "beafadb3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Año 2010: riesgo base residual con 'Polinómico grado 2' = 55.0% (umbral N1: <25-30%)\n",
      "[AVISO] Año 2015: sin pérdidas reales registradas en el panel filtrado.\n"
     ]
    }
   ],
   "source": [
    "COL_PAGO_FINAL = {\"Binario (v1/v2 original)\": \"pago_binario\",\n",
    "                   \"Lineal calibrado\": \"pago_lineal\",\n",
    "                   \"Polinómico grado 2\": \"pago_poly\"}[mejor_esquema]\n",
    "\n",
    "# Misma normalización usada en la sección 2.3 (min-max de pérdida, pago sobre su propio máximo)\n",
    "# para que el riesgo base sea comparable entre v2 (binario) y v3 (curva continua).\n",
    "for anio in [2010, 2015]:\n",
    "    sub = panel_v2[panel_v2[\"anio\"] == anio].copy()\n",
    "    if len(sub) == 0 or sub[\"anio_perdida\"].sum() == 0:\n",
    "        print(f\"[AVISO] Año {anio}: sin pérdidas reales registradas en el panel filtrado.\")\n",
    "        continue\n",
    "    rango = sub[\"perdida\"].max() - sub[\"perdida\"].min()\n",
    "    sub[\"perdida_normalizada\"] = (sub[\"perdida\"] - sub[\"perdida\"].min()) / (rango + 1e-9)\n",
    "    sub[\"pago_normalizado\"] = sub[COL_PAGO_FINAL] / PAYOUT_MAX\n",
    "    riesgo_base = (sub[\"perdida_normalizada\"] - sub[\"pago_normalizado\"]).abs().mean() * 100\n",
    "    print(f\"Año {anio}: riesgo base residual con \\'{mejor_esquema}\\' = {riesgo_base:.1f}% (umbral N1: <25-30%)\")"
   ]
  },
