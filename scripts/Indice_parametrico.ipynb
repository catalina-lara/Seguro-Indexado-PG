   "id": "2470f2ea",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filas utilizables para el índice v1: 643\n",
      "                           correlacion_con_perdida  signo_aplicado  peso_abs  \\\n",
      "temp_media_anual_anomalia                -0.277449            -1.0  0.277449   \n",
      "precip_anual_mm_anomalia                  0.198784             1.0  0.198784   \n",
